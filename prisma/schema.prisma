generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
}

enum InstallationStatus {
  ACTIVE
  PAUSED
  UNINSTALLED
}

enum EventDirection {
  INBOUND  // a platform sent it to a module
  OUTBOUND // a module sent it to a platform
}

/// A company running Canvas modules, e.g. Aultrum itself or a reseller.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  platforms     Platform[]
  installations Installation[]
  auditEvents   AuditEvent[]
}

model User {
  id               String    @id @default(cuid())
  organizationId   String
  email            String    @unique
  name             String
  passwordHash     String
  role             Role      @default(ADMIN)
  sessionVersion   Int       @default(0)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEvents  AuditEvent[]
}

/// A product that streams Canvas modules into itself, e.g. Pleasant. It calls
/// the Canvas API with its client ID and secret, and receives signed webhooks.
model Platform {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  clientId       String    @unique
  /// SHA-256 of the client secret. The secret is shown once, when created or rotated.
  secretHash     String
  /// Signs webhooks to this platform. Shown once, with the client secret.
  webhookSecret  String
  webhookUrl     String?
  /// Origins allowed to embed module screens (CSP frame-ancestors).
  allowedOrigins String[]  @default([])
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installations Installation[]
}

/// One module switched on for one tenant of a platform, e.g. Gateway for
/// the agency "Brightwater Care" in Pleasant.
model Installation {
  id             String             @id @default(cuid())
  organizationId String
  platformId     String
  moduleKey      String
  tenantId       String
  tenantName     String
  status         InstallationStatus @default(ACTIVE)
  settings       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId], references: [id], onDelete: Cascade)
  events       Event[]

  @@unique([platformId, moduleKey, tenantId])
  @@index([organizationId, status])
}

model Event {
  id             String         @id @default(cuid())
  installationId String
  direction      EventDirection
  type           String
  payload        Json           @default("{}")
  /// OUTBOUND only: webhook delivery to the platform.
  deliveryStatus String?
  attempts       Int            @default(0)
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId, createdAt])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  summary        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Aultrum ID: one account across Aultrum's products (id.aultrum.co.uk), and
// Aultrum Workspace (workspace.aultrum.co.uk), the home that lists them.
// ---------------------------------------------------------------------------

/// A person's Aultrum ID. Products keep their own users and permissions and
/// link them to this by its id (the OpenID Connect "sub").
model Identity {
  id               String    @id @default(cuid())
  email            String    @unique
  name             String
  passwordHash     String
  sessionVersion   Int       @default(0)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  createdAt        DateTime  @default(now())

  codes       AuthCode[]
  memberships PlatformMembership[]
}

/// A product that signs people in with Aultrum ID (an OpenID Connect client).
model OAuthClient {
  id                     String    @id @default(cuid())
  clientId               String    @unique
  /// SHA-256 of the client secret, shown once when the client is created.
  secretHash             String
  name                   String
  /// pleasant | canvas | flowstate | tender | workspace
  product                String
  redirectUris           String[]
  postLogoutRedirectUris String[]  @default([])
  /// Where Workspace sends someone to open this product, signed in.
  launchUrl              String?
  revokedAt              DateTime?
  createdAt              DateTime  @default(now())

  codes       AuthCode[]
  memberships PlatformMembership[]
  activity    ActivityItem[]
}

/// One-time authorization code (60 seconds), stored as a SHA-256 hash.
model AuthCode {
  codeHash      String    @id
  clientId      String
  identityId    String
  redirectUri   String
  codeChallenge String
  nonce         String?
  scope         String
  expiresAt     DateTime
  usedAt        DateTime?

  client   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  identity Identity    @relation(fields: [identityId], references: [id], onDelete: Cascade)
}

/// An organisation a person belongs to in a product, reported by that product,
/// e.g. "Brightwater Care, Admin" in Pleasant.
model PlatformMembership {
  id         String   @id @default(cuid())
  identityId String
  clientId   String
  orgId      String
  orgName    String
  role       String
  lastSeenAt DateTime @default(now())

  identity Identity    @relation(fields: [identityId], references: [id], onDelete: Cascade)
  client   OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, identityId, orgId])
  @@index([identityId])
}

/// A short summary a product shares about an organisation ("12 invoices sent
/// to Xero"). Never care records or personal details.
model ActivityItem {
  id         String   @id @default(cuid())
  clientId   String
  orgId      String
  externalId String
  kind       String
  title      String
  detail     String?
  url        String?
  /// Membership roles that may see it, e.g. ["Admin", "Manager"]. Empty: everyone in the organisation.
  roles      String[] @default([])
  occurredAt DateTime
  createdAt  DateTime @default(now())

  client OAuthClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, orgId, externalId])
  @@index([clientId, orgId, occurredAt])
}
