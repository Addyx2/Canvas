generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  /// Sees only their own Peak points and rewards.
  CARER
}

enum InstallationStatus {
  ACTIVE
  PAUSED
  UNINSTALLED
}

enum EventDirection {
  INBOUND // a platform sent it to a module
  OUTBOUND // a module sent it to a platform
}

/// A company running Canvas modules, e.g. Aultrum itself or a reseller.
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users         User[]
  people        Person[]
  invites       Invite[]
  platforms     Platform[]
  installations Installation[]
  auditEvents   AuditEvent[]
}

model User {
  id               String    @id @default(cuid())
  organizationId   String
  email            String    @unique
  name             String
  passwordHash     String
  role             Role      @default(ADMIN)
  /// CARER only: the person in People whose Peak points they see.
  personId         String?
  sessionVersion   Int       @default(0)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  /// False until someone who signed up opens the link emailed to them.
  /// Defaults to true so accounts made before verification existed, and
  /// people who join through an invite, are not locked out.
  emailVerified    Boolean   @default(true)
  createdAt        DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditEvents  AuditEvent[]
  authTokens   AuthToken[]
}

/// A product that streams Canvas modules into itself, e.g. Pleasant. It calls
/// the Canvas API with its client ID and secret, and receives signed webhooks.
model Platform {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  clientId       String    @unique
  /// SHA-256 of the client secret. The secret is shown once, when created or rotated.
  secretHash     String
  /// Signs webhooks to this platform. Shown once, with the client secret.
  webhookSecret  String
  webhookUrl     String?
  /// Origins allowed to embed module screens (CSP frame-ancestors).
  allowedOrigins String[]  @default([])
  /// Set for systems that sign their requests with their own key instead of a
  /// secret (e.g. Pleasant). Canvas checks requests against this public key set
  /// and signs webhooks to them with its own key.
  jwksUri        String?
  /// The organisation's own Elements app (Gateway and Peak used directly in
  /// the console), rather than an outside system.
  builtIn        Boolean   @default(false)
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installations Installation[]
}

/// One module switched on for one tenant of a platform, e.g. Gateway for
/// the agency "Brightwater Care" in Pleasant.
model Installation {
  id             String             @id @default(cuid())
  organizationId String
  platformId     String
  moduleKey      String
  tenantId       String
  tenantName     String
  status         InstallationStatus @default(ACTIVE)
  settings       Json               @default("{}")
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  platform     Platform     @relation(fields: [platformId], references: [id], onDelete: Cascade)
  events       Event[]

  peakMembers          PeakMember[]
  peakEntries          PeakEntry[]
  peakRewards          PeakReward[]
  peakRedemptions      PeakRedemption[]
  peakBadges           PeakBadge[]
  gatewayPeople        GatewayPerson[]
  gatewayConversations GatewayConversation[]

  @@unique([platformId, moduleKey, tenantId])
  @@index([organizationId, status])
}

model Event {
  id             String         @id @default(cuid())
  installationId String
  direction      EventDirection
  type           String
  payload        Json           @default("{}")
  /// OUTBOUND only: webhook delivery to the platform.
  deliveryStatus String?
  attempts       Int            @default(0)
  lastError      String?
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId, createdAt])
}

model AuditEvent {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  summary        String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
}

/// Secrets Canvas makes for itself on first start (the signing secret for
/// sessions and embed tokens), so deploying needs no keys in settings.
/// AUTH_SECRET, when set, takes precedence.
model ServiceKey {
  name      String   @id
  value     String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------- Peak

enum PeakEntryKind {
  SHIFT
  ON_TIME
  STREAK
  PRAISE
  AWARD
  REDEMPTION
  REVERSAL
}

enum PeakRewardKind {
  CASH_OUT // paid through the platform's payroll
  PERK
}

enum PeakRedemptionStatus {
  PENDING
  APPROVED
  DECLINED
}

/// A person who earns Peak points, identified by the platform's own ID.
model PeakMember {
  id             String   @id @default(cuid())
  installationId String
  personId       String
  name           String
  /// Consecutive on-time clock-ins, for streak bonuses.
  streak         Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  installation Installation        @relation(fields: [installationId], references: [id], onDelete: Cascade)
  entries      PeakEntry[]
  redemptions  PeakRedemption[]
  badges       PeakBadge[]
  offerClaims  PartnerOfferClaim[]

  @@unique([installationId, personId])
}

/// The points ledger. A balance is the sum of a member's entries; entries are
/// never edited, only reversed.
model PeakEntry {
  id             String        @id @default(cuid())
  installationId String
  memberId       String
  kind           PeakEntryKind
  points         Int
  reason         String
  /// Stops the same platform event scoring twice, e.g. "clock:shift_123".
  sourceKey      String?
  byName         String?
  createdAt      DateTime      @default(now())

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  member       PeakMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([installationId, sourceKey])
  @@index([memberId, createdAt])
}

model PeakReward {
  id             String         @id @default(cuid())
  installationId String
  name           String
  description    String         @default("")
  kind           PeakRewardKind
  cost           Int
  active         Boolean        @default(true)
  createdAt      DateTime       @default(now())

  installation Installation     @relation(fields: [installationId], references: [id], onDelete: Cascade)
  redemptions  PeakRedemption[]
}

model PeakRedemption {
  id             String               @id @default(cuid())
  installationId String
  memberId       String
  rewardId       String?
  rewardName     String
  kind           PeakRewardKind
  points         Int
  /// CASH_OUT only: what the platform pays through payroll.
  amountPence    Int?
  status         PeakRedemptionStatus @default(PENDING)
  decidedBy      String?
  decidedAt      DateTime?
  note           String?
  createdAt      DateTime             @default(now())

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  member       PeakMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reward       PeakReward?  @relation(fields: [rewardId], references: [id], onDelete: SetNull)

  @@index([installationId, status])
}

// ---------------------------------------------------------------- Gateway

enum GatewayChannel {
  WEBCHAT
  SMS
  VOICE
}

enum GatewayStatus {
  WITH_AI // Gateway's agent is answering
  NEEDS_PERSON // waiting for a member of staff
  WITH_PERSON // a member of staff has taken over
  CLOSED
}

enum GatewayIntent {
  ENQUIRY
  MESSAGE
  EMERGENCY
  OTHER
  // No longer used: Gateway takes enquiries only. Kept so the deployed
  // database's enum is only ever added to, never shrunk.
  ABSENCE
  COVER_REQUEST
}

enum GatewaySender {
  CONTACT
  AGENT
  STAFF
  SYSTEM
}

/// People the platform knows, so Gateway recognises who is calling.
model GatewayPerson {
  id             String   @id @default(cuid())
  installationId String
  personId       String
  name           String
  /// E.164, e.g. +447700900123.
  phone          String?
  /// "carer", "client" or another label the platform uses.
  kind           String   @default("carer")
  organisation   String?
  updatedAt      DateTime @updatedAt

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@unique([installationId, personId])
  @@index([installationId, phone])
}

model GatewayConversation {
  id             String         @id @default(cuid())
  installationId String
  channel        GatewayChannel
  /// Phone number or web chat visitor key.
  contact        String
  contactName    String?
  personId       String?
  intent         GatewayIntent  @default(ENQUIRY)
  status         GatewayStatus  @default(WITH_AI)
  summary        String?
  handoverReason String?
  staffName      String?
  /// The agent's conversation state (Claude messages), so a turn can resume.
  agentState     Json           @default("[]")
  /// Set when Gateway took an enquiry or a message that someone should follow up.
  followUp       Boolean        @default(false)
  followUpDoneAt DateTime?
  followUpBy     String?
  /// When the team was last emailed about this conversation, so a busy
  /// conversation sends one alert rather than one per message.
  alertedAt      DateTime?
  lastMessageAt  DateTime       @default(now())
  createdAt      DateTime       @default(now())

  installation Installation     @relation(fields: [installationId], references: [id], onDelete: Cascade)
  messages     GatewayMessage[]

  @@index([installationId, status, lastMessageAt])
  @@index([installationId, contact])
}

model GatewayMessage {
  id             String        @id @default(cuid())
  conversationId String
  sender         GatewaySender
  body           String
  staffName      String?
  createdAt      DateTime      @default(now())

  conversation GatewayConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------- People and team (Elements used on its own)

/// Someone the organisation works with: a carer (earns Peak points), a client
/// contact, or anyone else Gateway should recognise when they call.
model Person {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  phone          String?
  email          String?
  kind           String   @default("carer")
  organisation   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, kind])
}

/// An invitation to join the organisation. The link is shown once; only its hash is kept.
model Invite {
  id             String    @id @default(cuid())
  organizationId String
  email          String
  name           String
  role           Role
  personId       String?
  tokenHash      String    @unique
  invitedBy      String
  expiresAt      DateTime
  acceptedAt     DateTime?
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

/// One-time links emailed to a user: confirming their email, or resetting
/// their password. Only a hash of the token is stored.
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  /// "verify_email" | "reset_password"
  kind      String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// Fixed-window counters for rate limits, keyed by action and who is acting.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/// Recognition a manager gives someone in Peak: a badge with a note, and
/// sometimes bonus points (recorded separately as an AWARD entry).
model PeakBadge {
  id             String   @id @default(cuid())
  installationId String
  memberId       String
  /// A key from lib/peak/badges.ts, e.g. "kindness".
  badge          String
  note           String
  byName         String
  points         Int      @default(0)
  createdAt      DateTime @default(now())

  installation Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  member       PeakMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, createdAt])
  @@index([installationId, createdAt])
}

/// An offer from an Aultrum partner that every carer on Peak can use, such as
/// a discount on training. Managed by Aultrum, not by each organisation.
model PartnerOffer {
  id          String    @id @default(cuid())
  partner     String
  title       String
  description String    @default("")
  /// training | wellbeing | money | shopping | other
  category    String    @default("other")
  /// Shown as the headline, e.g. "20% off".
  headline    String
  /// A discount code to show once someone claims the offer.
  code        String?
  /// Where to use it.
  url         String?
  active      Boolean   @default(true)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  claims PartnerOfferClaim[]
}

/// Someone opened an offer. Only counts are shared with partners.
model PartnerOfferClaim {
  id             String   @id @default(cuid())
  offerId        String
  installationId String
  memberId       String
  createdAt      DateTime @default(now())

  offer  PartnerOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  member PeakMember   @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([offerId, memberId])
}
