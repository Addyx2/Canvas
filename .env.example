# Postgres connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canvas

# Signs sessions and embed tokens. At least 32 random characters in production
# (openssl rand -hex 32).
AUTH_SECRET=

# The public URL of this deployment, used in embed URLs handed to platforms.
APP_URL=https://canvas.aultrum.co.uk

# Aultrum ID and Aultrum Workspace, served by this same deployment on their
# own domains. In development they default to id.localhost:3200 and
# workspace.localhost:3200 (browsers resolve *.localhost to this machine).
AULTRUM_ID_URL=https://id.aultrum.co.uk
AULTRUM_WORKSPACE_URL=https://workspace.aultrum.co.uk
# RSA private key (PKCS#8 PEM) that signs Aultrum ID tokens. Required in
# production: openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
AULTRUM_ID_SIGNING_KEY=
