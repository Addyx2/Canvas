# The only setting Canvas needs: its own Postgres database. On Vercel,
# Storage → create a database fills this in.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/canvas

# Optional. The signing secret for sessions and embed tokens is made on first
# start and kept in the database; set AUTH_SECRET only to supply your own.
# APP_URL defaults to https://canvas.aultrum.co.uk when deployed.
# AUTH_SECRET=
# APP_URL=
